# ── Aurelle ERP — variables de entorno ──────────────────────────────────────
# Copia este archivo a .env.local y llena los valores. NUNCA subas .env.local
# al repo (está en .gitignore). En producción, define estas variables en Vercel.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Clave de servicio de Supabase — SOLO server-side (migraciones, jobs, webhooks).
# Nunca la expongas al navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── Integraciones (fases posteriores; dejar vacías por ahora) ────────────────
# Anthropic API (capa de IA — Fase 5)
ANTHROPIC_API_KEY=

# WhatsApp Business Cloud API (Fase 3)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# API de precios de metales (Cotizador — Fase 1)
METALS_API_KEY=

# Secreto del cron de Vercel (Gastos recurrentes — Fase 2). Cualquier cadena larga.
# Vercel Cron lo envía como header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
